# Host-local Bot-tazzi call transcription runtime.
# Keep Faster-Whisper offline; point this cache at an already provisioned model.
PATH=/path/to/faster-whisper-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
BOTTAZZI_CALL_STT_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
BOTTAZZI_CALL_STT_CACHE_DIR=/path/to/faster-whisper-cache
BOTTAZZI_CALL_STT_LOCAL_ONLY=1
BOTTAZZI_CALL_STT_LANGUAGE=it
BOTTAZZI_CALL_STT_DEVICE=cpu
BOTTAZZI_CALL_STT_COMPUTE_TYPE=int8
BOTTAZZI_CALL_STT_CPU_THREADS=4
# BOTTAZZI_CALL_RECORDINGS_DIR defaults to ~/.local/share/bottazzi/call-recordings
