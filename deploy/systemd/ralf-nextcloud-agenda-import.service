[Unit]
Description=Import Bot-tazzi Agenda ICS spool into Nextcloud
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/bandi/ralfloop-bottazzi-agenda-20260923
Environment=PYTHONPATH=/home/bandi/ralfloop-bottazzi-agenda-20260923
Environment=BOTTAZZI_AGENDA_CALENDAR_DIR=/var/lib/ralfloop-bottazzi-agenda/calendar
Environment=BOTTAZZI_AGENDA_CALENDAR_ARCHIVE=/var/lib/ralfloop-bottazzi-agenda/imported
Environment=BOTTAZZI_NEXTCLOUD_CALENDAR_UID=bottazzi-agenda
Environment=BOTTAZZI_NEXTCLOUD_CALENDAR_URI=bottazzi-agenda
ExecStart=/home/sibilla-cumana/ralfloop_agent_scaffold/.venv/bin/python scripts/ralf_nextcloud_agenda_import.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/ralfloop-bottazzi-agenda
