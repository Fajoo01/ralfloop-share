[Unit]
Description=Ralf Colibri/GLM bounded night review worker
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/home/sibilla-cumana/ralfloop-production/current
Environment=PYTHONPATH=/home/sibilla-cumana/ralfloop-production/current
Environment=RALFLOOP_GLM_STATE_DIR=/home/sibilla-cumana/.local/state/ralfloop/glm-review
Environment=RALFLOOP_COLIBRI_LAUNCHER=/home/sibilla-cumana/Dati/ralfloop-colibri/bin/glm-run
Environment=RALFLOOP_GLM_NGEN=128
Environment=RALFLOOP_GLM_CONTEXT_MAX_CHARS=6000
Environment=RALFLOOP_GLM_TIMEOUT_SECONDS=3600
Environment=RALFLOOP_GLM_DIRECTOR_ENABLED=1
Environment=RALFLOOP_GLM_MAX_ROUNDS=3
Environment=RALFLOOP_GLM_MAX_ASSIGNMENTS=5
Environment=RALFLOOP_GLM_DIRECTOR_TIME_BUDGET_SECONDS=7200
Environment=RALFLOOP_GLM_WORKER_CALL_BUDGET=15
Environment=RALFLOOP_GLM_APPROVAL_TTL_SEC=86400
EnvironmentFile=-/etc/ralfloop/telegram-approval.env
ExecStart=/home/sibilla-cumana/ralfloop_agent_scaffold/.venv/bin/python -m ralfloop_agent.cli.terminal_chat glm worker --limit 1
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=7500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sibilla-cumana/.local/state/ralfloop/glm-review /home/sibilla-cumana/Dati/ralfloop-colibri/logs /home/sibilla-cumana/Dati/ralfloop-colibri/runtime /var/lib/ralfloop
