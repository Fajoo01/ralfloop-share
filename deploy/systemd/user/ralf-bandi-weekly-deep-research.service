After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sibilla-cumana/ralfloop-production/current
Environment=PYTHONPATH=/home/sibilla-cumana/ralfloop-production/current
Environment=TZ=Europe/Rome
Environment=RALFLOOP_BANDO_SEARCH_PROVIDER=searxng
Environment=RALFLOOP_SEARXNG_URL=http://127.0.0.1:8889
Environment=RALFLOOP_SEARXNG_ENGINES=bing,startpage,duckduckgo
Environment=BANDI_WEEKLY_STATE_DIR=/home/sibilla-cumana/.local/state/ralfloop/bandi_weekly_deep_research
