[Unit]
Description=Bot-tazzi site-aware observational activity sessionizer
After=bottazzi-activity-correlator.service

[Service]
Type=oneshot
User=sibilla-cumana
Group=sibilla-cumana
StateDirectory=bottazzi-site-correlator
UMask=0077
ExecStart=/usr/bin/python3 /opt/bottazzi-presence/site_activity_sessionizer.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
