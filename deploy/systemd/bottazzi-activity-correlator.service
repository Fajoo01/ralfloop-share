[Unit]
Description=Bot-tazzi unified surveillance/domotics activity correlator
After=bottazzi-passage-tracker.service bottazzi-presence-correlator.service bottazzi-guest-tracker.service ralf-domotics-health-watchdog.service

[Service]
Type=oneshot
User=sibilla-cumana
Group=sibilla-cumana
StateDirectory=bottazzi-activity-correlator
UMask=0077
ExecStart=/usr/bin/python3 /opt/bottazzi-presence/activity_event_correlator.py --state /var/lib/bottazzi-activity-correlator/state.json --out /var/lib/bottazzi-activity-correlator/events.jsonl
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
