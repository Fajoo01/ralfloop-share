[Unit]
Description=Ralf Browser Rizzo semantic target shadow scorer
After=network.target

[Service]
Type=simple
User=bandi
Group=bandi
WorkingDirectory=/home/bandi/experiments/rizzo-flow-20260925
ExecStart=/home/bandi/experiments/rizzo-flow-20260925/.venv/bin/rizzo serve --model /home/bandi/experiments/rizzo-flow-20260925/models/Spark-X2.5-4B-GGUF/Spark-X2.5-4B-Q4_K_M.gguf --device vulkan --host 127.0.0.1 --port 18017 --batch-size 4
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
