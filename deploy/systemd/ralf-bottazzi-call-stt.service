[Unit]
Description=Bot-tazzi offline phone-call transcription worker
After=ralfloop-backend.service
Wants=ralfloop-backend.service

[Service]
Type=simple
User=sibilla-cumana
Group=sibilla-cumana
WorkingDirectory=/home/sibilla-cumana/ralfloop-production/bottazzi-call-current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/sibilla-cumana/ralfloop-production/bottazzi-call-current
Environment=BOTTAZZI_CALL_RECORDINGS_DIR=/var/lib/ralfloop-bottazzi-call-recordings
EnvironmentFile=-/etc/ralfloop/bottazzi-call-stt.env
ExecStart=/usr/bin/env python3 /home/sibilla-cumana/ralfloop-production/bottazzi-call-current/scripts/ralf_bottazzi_call_stt_worker.py --interval 15 --limit 4
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
CPUQuota=400%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=ralfloop-bottazzi-call-recordings
ReadWritePaths=/var/lib/ralfloop-bottazzi-call-recordings

[Install]
WantedBy=multi-user.target
