[Unit]
Description=Ralf Teacher shared Qwen inference daemon
After=network.target ralf-llama-cpp-lifecycle-broker.service ralf-agentcpm-lifecycle-broker.service
Wants=ralf-llama-cpp-lifecycle-broker.service ralf-agentcpm-lifecycle-broker.service

[Service]
Type=simple
User=bandi
Group=bandi

WorkingDirectory=/home/sibilla-cumana/ralfloop-production/current
Environment=PYTHONPATH=/home/sibilla-cumana/ralfloop-production/current
EnvironmentFile=/etc/ralfloop/fast-chat.env

RuntimeDirectory=ralf-teacher-inference
RuntimeDirectoryMode=0750

ExecStart=/home/sibilla-cumana/ralfloop_agent_scaffold/.venv/bin/python /home/sibilla-cumana/ralfloop-production/current/scripts/ralf_teacher_inference_daemon.py --socket /run/ralf-teacher-inference/inference.sock --allow-uid 1001 --idle-timeout 300

Restart=on-failure
RestartSec=2
TimeoutStopSec=120

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

UMask=0077

[Install]
WantedBy=multi-user.target
