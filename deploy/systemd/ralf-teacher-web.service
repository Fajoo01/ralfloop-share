[Unit]
Description=Bot-tazzi Teacher student web (loopback)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ralf-teacher-web/current
EnvironmentFile=%h/.config/ralf-teacher-web.env
ExecStart=/home/sibilla-cumana/ralfloop_agent_scaffold/.venv/bin/python scripts/ralf_teacher_web.py --port 19139
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=yes
# PrivateTmp in this user manager isolates access to the owner's 0700 MCP socket.
# Keep the existing socket boundary; do not loosen its permissions.
UMask=0077

[Install]
WantedBy=default.target
