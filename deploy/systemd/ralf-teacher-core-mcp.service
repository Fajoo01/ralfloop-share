[Unit]
Description=Ralf Teacher internal deterministic C core MCP
After=local-fs.target

[Service]
Type=simple
User=bandi
Group=bandi
WorkingDirectory=/home/sibilla-cumana/ralfloop-production/current
RuntimeDirectory=ralf-teacher-core
RuntimeDirectoryMode=0700
ExecStart=/home/sibilla-cumana/ralfloop-production/current/bin/ralf-teacher-core-mcp --socket /run/ralf-teacher-core/core.sock --allow-uid 1001
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target
