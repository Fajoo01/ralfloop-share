[Unit]
Description=Bot-tazzi GPT session shepherd with user countdown
After=bottazzi-gpt-browser.service network-online.target

[Service]
Type=oneshot
User=bandi
Group=ralf-mcp
Environment=HOME=/home/bandi
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/bandi/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus
ExecStart=/home/bandi/.local/share/bottazzi-gpt-browser/bottazzi_gpt_shepherd_guard.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bandi/.local/state/bottazzi/gpt-session /run/user/1001
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
