[Unit]
Description=VPN-only firewall rule for Ralf Teacher MCP bridge
Requires=vpn-service-ips.service
After=wg-quick@sibilla.service vpn-service-ips.service
Before=ralf-teacher-tcp-bridge.service

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=/home/sibilla-cumana/ralfloop-production/current/scripts/ralf_teacher_vpn_firewall.sh up
ExecStop=/home/sibilla-cumana/ralfloop-production/current/scripts/ralf_teacher_vpn_firewall.sh down

NoNewPrivileges=no
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
