[Unit]
Description=Bot-tazzi dedicated ChatGPT Chrome (isolated profile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bandi
Group=ralf-mcp
Environment=HOME=/home/bandi
Environment=BOTTAZZI_GPT_PROFILE_DIR=/home/bandi/.local/share/bottazzi-gpt-browser/profile
Environment=BOTTAZZI_GPT_CACHE_DIR=/tmp/bottazzi-gpt-browser-cache
Environment=BOTTAZZI_GPT_CDP_PORT=9237
Environment=BOTTAZZI_GPT_HEADLESS=1
ExecStart=/home/bandi/.local/share/bottazzi-gpt-browser/bottazzi_gpt_browser.sh
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bandi/.local/share/bottazzi-gpt-browser /tmp/bottazzi-gpt-browser-cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
